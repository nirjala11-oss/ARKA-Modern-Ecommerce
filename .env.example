# ==============================================================================
# ARKA LUXURY E-COMMERCE - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for development or configure in your deployment platform (Vercel, AWS ECS, Docker).

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# For Supabase / Neon / AWS RDS: Use connection pooling URL for serverless runtimes.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECRETS (NextAuth & JWT)
# ------------------------------------------------------------------------------
# Canonical application URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# Generate a strong 256-bit secret key in terminal using:
# openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-character-or-longer-secret-key-in-production"
JWT_SECRET="replace-with-a-random-32-character-or-longer-secret-key-in-production"

# ------------------------------------------------------------------------------
# 3. INITIAL ADMIN SEED CREDENTIALS (Optional for first-time bootstrap)
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@ecommerce.com"
ADMIN_PASSWORD="ChangeMeInProduction!2025"

# ------------------------------------------------------------------------------
# 4. REDIS CACHE & DISTRIBUTED RATE LIMITING (Optional / Production)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 5. CONTAINER / DEPLOYMENT SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
STANDALONE_BUILD="false"
